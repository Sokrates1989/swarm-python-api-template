# Example generated from the Felix schema-5 executable site profile.
#
# Guided or generated-file setup writes the ignored root .env. This tracked
# file documents every public field; it is not a manual setup prerequisite.
# Passwords, tokens, and client secrets never belong here. Runtime values use
# Docker secrets or the hidden, non-persistent Keycloak SMTP prompt.
PROFILE_SCHEMA_VERSION=5.0
DEPLOYMENT_PROFILE_ID=felix
APP_ID=felix
APP_ENVIRONMENT=production
APP_PROFILE=felix
BACKEND_APP_ID=felix
BACKEND_DATA_PROFILE=postgresql
AUTH_PROVIDER=keycloak
API_BASE_URL=https://api.felix-app.fe-wi.com
DOMAIN=api.felix-app.fe-wi.com
WEB_BASE_URL=https://felix-app.fe-wi.com
WEB_DOMAIN=felix-app.fe-wi.com
CORS_ORIGINS=https://felix-app.fe-wi.com
KEYCLOAK_BASE_URL=https://keycloak.fe-wi.com
KEYCLOAK_ISSUER_URL=https://keycloak.fe-wi.com/realms/felix
KEYCLOAK_REALM=felix
KEYCLOAK_REALM_DISPLAY_NAME=Felix
KEYCLOAK_REALM_ENABLED=true
KEYCLOAK_REGISTRATION_ALLOWED=true
KEYCLOAK_RESET_PASSWORD_ALLOWED=true
KEYCLOAK_REMEMBER_ME=true
KEYCLOAK_VERIFY_EMAIL=true
KEYCLOAK_LOGIN_WITH_EMAIL_ALLOWED=true
KEYCLOAK_LOGIN_THEME=default
KEYCLOAK_ACCOUNT_THEME=default
KEYCLOAK_ADMIN_THEME=default
KEYCLOAK_EMAIL_THEME=default
KEYCLOAK_INTERNATIONALIZATION_ENABLED=true
KEYCLOAK_SUPPORTED_LOCALES=de,en
KEYCLOAK_DEFAULT_LOCALE=de
KEYCLOAK_EMAIL_SENDER_ENABLED=false
KEYCLOAK_SMTP_FROM=webmaster@felicitas-wisdom.com
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=FelixApp Keycloak Admin
KEYCLOAK_SMTP_REPLY_TO=felix@felicitas-wisdom.com
KEYCLOAK_SMTP_REPLY_TO_DISPLAY_NAME=FelixApp
KEYCLOAK_SMTP_ENVELOPE_FROM=
KEYCLOAK_SMTP_HOST=smtp.strato.de
KEYCLOAK_SMTP_PORT=465
KEYCLOAK_SMTP_STARTTLS=false
KEYCLOAK_SMTP_SSL=true
KEYCLOAK_SMTP_AUTH=true
KEYCLOAK_SMTP_USERNAME=webmaster@felicitas-wisdom.com
KEYCLOAK_BOOTSTRAP_TEST_USERS_ENABLED=true
KEYCLOAK_BOOTSTRAP_USERS_CLEANUP_PENDING=false
KEYCLOAK_BOOTSTRAP_USERS_CLEANUP_NAMES=
KEYCLOAK_AUDIENCE=felix-backend
KEYCLOAK_FRONTEND_CLIENT_ID=felix-frontend
KEYCLOAK_BACKEND_CLIENT_ID=felix-backend
STACK_NAME=felix
STACK_FAMILY=api
STACK_ROLE=full-stack
PRIMARY_SERVICE=api
DB_TYPE=postgresql
DB_MODE=local
DB_HOST=postgres
DB_PORT=5432
DB_NAME=felix
DB_USER=felix
PROXY_TYPE=traefik
SSL_MODE=proxy
TRAEFIK_NETWORK=traefik-public
TRAEFIK_CONSTRAINT_LABEL=traefik-public
TRAEFIK_CERT_RESOLVER=le
API_PUBLISHED_PORT=8083
WEB_PUBLISHED_PORT=8084
PGADMIN_PUBLISHED_PORT=5054
IMAGE_NAME=sokrates1989/python-api-felix
IMAGE_VERSION=1.0.8
API_REPLICAS=1
# `unlimited` or `0` omits deploy.resources.limits.memory. Explicit byte
# quantities accept K/M/G/T aliases such as 512M or 2G.
MEMORY_LIMIT=unlimited
# true enables production-safe INFO diagnostics; false keeps WARNING/ERROR.
# Sensitive HTTP bodies/headers, SQL echo, and framework DEBUG remain off.
ADVANCED_LOGGING_ENABLED=true
DATA_ROOT=/swarm/prod/felix
PGADMIN_ENABLED=false
PGADMIN_DOMAIN=pgadmin.felix-app.fe-wi.com
PGADMIN_EMAIL=admin@fe-wi.com
PGADMIN_REPLICAS=0
WEB_ENABLED=true
WEB_IMAGE_NAME=sokrates1989/flutter-felix-web
WEB_IMAGE_VERSION=1.0.8
WEB_REPLICAS=1
WEB_MEMORY_LIMIT=unlimited
