# Docker Secrets Template
# ========================
# Fill in values for each secret. Secret names will be prefixed with your
# stack's SECRET_PREFIX (e.g., myapp_DB_PASSWORD, myapp_ADMIN_API_KEY).
#
# IMPORTANT:
# - This file contains sensitive values. Delete it after creating Docker secrets.
# - Use strong, unique passwords for production deployments.
# - The SECRET_PREFIX is derived from your STACK_NAME in .env.

# Database password (required for local database mode)
DB_PASSWORD=

# Admin API key (required for admin endpoints)
ADMIN_API_KEY=

# Backup API keys (required for backup/restore operations)
BACKUP_RESTORE_API_KEY=
BACKUP_DELETE_API_KEY=

# Admin UI password (required when using local database with admin UI)
# This password is used for pgAdmin (PostgreSQL) or Mongo Express (MongoDB)
DB_UI_ADMIN_PASSWORD=
