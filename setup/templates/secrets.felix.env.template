# Felix candidate Docker secret input template
# ============================================================
# This ignored operator file is only a transient input for creating Docker
# secrets. Never commit values, print them, or place them in prod.env/.env.
#
# Required for local PostgreSQL and Keycloak account administration.
FELIX_NEW_DB_PASSWORD=
FELIX_NEW_KEYCLOAK_ADMIN_CLIENT_SECRET=

# Optional: uncomment only after enabling the matching capability in
# site-configs/felix.json and extending envKeys as documented there.
# FELIX_NEW_AI_CHAT_API_KEY=
# FELIX_NEW_WEB_PUSH_VAPID_PUBLIC_KEY=
# FELIX_NEW_WEB_PUSH_VAPID_PRIVATE_KEY=
