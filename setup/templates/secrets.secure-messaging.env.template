# Secure Messaging Docker Secrets Template
# Delete this file after creating Docker secrets.

# Single auth token (any caller with this token can use the API)
secure_messaging_auth_token=

# Telegram metadata (JSON - chat_ids only, NO tokens)
secure_messaging_telegram_metadata=

# Telegram tokens (JSON - bot tokens only)
secure_messaging_telegram_tokens=

# Email metadata (JSON - host, port, username, etc., NO passwords)
secure_messaging_email_metadata=

# Email passwords (JSON - SMTP passwords only)
secure_messaging_email_passwords=

# Example auth token:
# replace-with-a-long-random-secret-string

# Example telegram_metadata JSON (recipient keys map to chat_ids):
# {"backup":{"info":"-5109048777","warning":"-5139430766","error":"-4994923325"},"countdown":{"admin":"-714317354"}}

# Example telegram_tokens JSON:
# {"bot-main":"bot-token-1","bot-alerts":"bot-token-2"}

# Example email_metadata JSON (receivers nested under "receivers" key):
# {"gmail-primary":{"host":"smtp.gmail.com","port":"587","username":"user@gmail.com","use_tls":"true","from":"user@gmail.com","receivers":{"info":"info@example.com","warning":"alerts@example.com","error":"oncall@example.com"}}}

# Example email_passwords JSON:
# {"gmail-primary":"app-password-1","strato-backup":"app-password-2"}
