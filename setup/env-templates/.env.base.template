# Base environment configuration
# Common settings for all deployments

# Replication settings
API_REPLICAS=1
REDIS_REPLICAS=1

# Docker Image Configuration
# This should match the image built and pushed from the main python-api-template repository
IMAGE_NAME=your-username/your-api-name
IMAGE_VERSION=0.0.3

# Other settings
DATA_ROOT=/gluster_storage/swarm/python-api-template/api.example.com
STACK_NAME=api_production

# Python Version (should match the image)
PYTHON_VERSION=3.13

# API Settings
PORT=8000
DEBUG=false

# Redis Configuration
# Note: In Docker Swarm, service names are prefixed with stack name
# This will be redis://<STACK_NAME>_redis:6379
REDIS_URL=redis://${STACK_NAME}_redis:6379

# Authentication Provider Configuration (optional)
# Supported values: cognito, keycloak, dual, none
AUTH_PROVIDER=cognito

# Keycloak Configuration (optional)
# KEYCLOAK_INTERNAL_URL can point to the internal service name in Swarm.
# KEYCLOAK_ISSUER_URL and KEYCLOAK_JWKS_URL are derived automatically if left empty.
# KEYCLOAK_SERVER_URL=http://localhost:9090
# KEYCLOAK_INTERNAL_URL=http://keycloak:9090
# KEYCLOAK_REALM=python-api-template
# KEYCLOAK_CLIENT_ID=python-api-template-backend
# KEYCLOAK_CLIENT_SECRET=change-me
# KEYCLOAK_ISSUER_URL=http://localhost:9090/realms/python-api-template
# KEYCLOAK_JWKS_URL=http://keycloak:9090/realms/python-api-template/protocol/openid-connect/certs

# AWS Cognito Configuration (optional)
# These values will be populated automatically if you configure AWS Cognito
# during setup wizard or by running option 9 in quick-start scripts.
# AWS credentials will be stored as Docker secrets for security.
# AWS_REGION=eu-central-1
# COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
# COGNITO_APP_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
