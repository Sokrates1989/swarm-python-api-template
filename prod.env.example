# Felix candidate-production Swarm public profile (schema version 1).
#
# Copy this file to prod.env and replace the `.invalid` API host. The copy is
# ignored by Git and must contain only public configuration, never credentials.
# Root `.env` is generated from the validated copy for legacy tool compatibility.
PROFILE_SCHEMA_VERSION=1
APP_ID=felix
APP_ENVIRONMENT=production
APP_PROFILE=felix
BACKEND_APP_ID=felix
BACKEND_DATA_PROFILE=postgresql
AUTH_PROVIDER=keycloak
API_BASE_URL=https://api.example.invalid
DOMAIN=api.example.invalid
CORS_ORIGINS=https://felix-app.fe-wi.com
KEYCLOAK_BASE_URL=https://keycloak.fe-wi.com
KEYCLOAK_ISSUER_URL=https://keycloak.fe-wi.com/realms/felix-new
KEYCLOAK_REALM=felix-new
KEYCLOAK_AUDIENCE=felix-new-backend
KEYCLOAK_FRONTEND_CLIENT_ID=felix-new-frontend
STACK_NAME=felix-new
