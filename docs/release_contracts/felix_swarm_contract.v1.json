{
  "schemaVersion": 1,
  "owner": "swarm",
  "appId": "felix",
  "siteProfile": "felix",
  "siteProfileDisplayName": "Felix Backend and WebApp",
  "environment": "production",
  "productionKeycloakOwner": {
    "repository": "https://github.com/Sokrates1989/swarm-keycloak.git",
    "deploymentPath": "/swarm/administration/keycloak",
    "localDevelopmentRepositoryIsProductionDependency": false,
    "separateToolCheckoutRequired": false
  },
  "candidate": {
    "webOrigin": "https://felix-app.fe-wi.com",
    "apiOrigin": "https://api.felix-app.fe-wi.com",
    "issuerUrl": "https://keycloak.fe-wi.com/realms/felix-new",
    "realm": "felix-new",
    "frontendClientId": "felix-new-frontend",
    "backendAudience": "felix-new-backend",
    "backendAdminClientId": "felix-new-backend",
    "backendServiceAccountClientRoles": {
      "realm-management": [
        "manage-users"
      ]
    }
  },
  "legacyProtection": {
    "webOrigin": "https://felix.app.fe-wi.com",
    "protectedRealms": [
      "felix",
      "felixappnew"
    ],
    "protectedClientIds": [
      "felixappnew-frontend"
    ]
  },
  "requiredEnvironmentFields": [
    "APP_PROFILE",
    "BACKEND_APP_ID",
    "AUTH_PROVIDER",
    "CORS_ORIGINS",
    "KEYCLOAK_ISSUER_URL",
    "KEYCLOAK_REALM",
    "KEYCLOAK_AUDIENCE"
  ],
  "requiredWebDeploymentFields": [
    "WEB_DOMAIN",
    "WEB_IMAGE_NAME",
    "WEB_IMAGE_VERSION",
    "WEB_REPLICAS",
    "WEB_MEMORY_LIMIT"
  ],
  "requiredSecretFileFields": [
    "KEYCLOAK_ADMIN_CLIENT_SECRET_FILE"
  ],
  "configurationInput": {
    "trackedExample": ".env.example",
    "wizardGenerated": ".env",
    "forbiddenRequiredInput": "prod.env"
  },
  "stackServices": {
    "required": [
      "web",
      "api",
      "redis"
    ],
    "databaseModes": [
      "local-postgresql",
      "external-postgresql-secret-file"
    ],
    "optional": [
      "pgadmin"
    ]
  },
  "deploymentBoundary": {
    "candidateHost": "felix-app.fe-wi.com",
    "candidateApiHost": "api.felix-app.fe-wi.com",
    "candidateStackName": "felix-new",
    "legacyHost": "felix.app.fe-wi.com",
    "legacyForwardingRequiresCutoverApproval": true,
    "mutableImageTagsAllowed": false
  }
}
