{
  "$schema": "site-config-schema",
  "version": "3.0",
  "appId": "example_app",
  "name": "Example App",
  "description": "Human-readable description of this backend app",
  "database": {
    "type": "postgresql",
    "defaultMode": "local"
  },
  "services": {
    "redis": true,
    "database": true
  },
  "image": {
    "name": "your-username/your-api-image",
    "defaultVersion": "latest"
  },
  "resources": {
    "defaultReplicas": 1,
    "defaultMemoryLimit": "512M"
  },
  "secrets": [
    "DB_PASSWORD",
    "ADMIN_API_KEY",
    "BACKUP_RESTORE_API_KEY",
    "BACKUP_DELETE_API_KEY"
  ],
  "envKeys": [
    "BACKEND_APP_ID",
    "DB_TYPE",
    "DB_MODE"
  ],
  "notes": "This is a template. Copy it to create a manifest for your app."
}
