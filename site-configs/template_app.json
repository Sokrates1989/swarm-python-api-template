{
  "version": "3.0",
  "appId": "template_app",
  "name": "Template App",
  "description": "Template backend app with PostgreSQL and sync routes",
  "database": {
    "type": "postgresql",
    "defaultMode": "local"
  },
  "services": {
    "redis": true,
    "database": true
  },
  "image": {
    "name": "sokrates1989/python-api-template_app",
    "defaultVersion": "latest"
  },
  "resources": {
    "defaultReplicas": 1,
    "defaultMemoryLimit": "512M"
  },
  "secrets": [
    "DB_PASSWORD",
    "ADMIN_API_KEY",
    "BACKUP_RESTORE_API_KEY",
    "BACKUP_DELETE_API_KEY"
  ],
  "envKeys": [
    "BACKEND_APP_ID",
    "DB_TYPE",
    "DB_MODE",
    "POSTGRES_DB",
    "POSTGRES_USER"
  ],
  "notes": "Template app with PostgreSQL backend and sync routes"
}
