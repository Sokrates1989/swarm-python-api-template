{
  "$schema": "site-config-schema",
  "version": "3.0",
  "appId": "mongodb_template",
  "name": "MongoDB Template",
  "description": "MongoDB-based API backend app",
  "database": {
    "type": "mongodb",
    "defaultMode": "local"
  },
  "services": {
    "redis": true,
    "database": true
  },
  "adminUI": {
    "type": "mongo-express",
    "defaultDomainPrefix": "admin",
    "defaultReplicas": 0,
    "configurableReplicas": false
  },
  "image": {
    "name": "sokrates1989/python-api-mongodb-template",
    "defaultVersion": "latest"
  },
  "resources": {
    "defaultReplicas": 1,
    "defaultMemoryLimit": "512M"
  },
  "secrets": [
    "DB_PASSWORD",
    "ADMIN_API_KEY",
    "BACKUP_RESTORE_API_KEY",
    "BACKUP_DELETE_API_KEY",
    "DB_UI_ADMIN_PASSWORD"
  ],
  "envKeys": [
    "BACKEND_APP_ID",
    "DB_TYPE",
    "DB_MODE",
    "MONGODB_DB",
    "MONGODB_USER"
  ],
  "notes": ""
}
