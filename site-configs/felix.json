{
  "$schema": "site-config-schema",
  "version": "5.0",
  "appId": "felix",
  "name": "Felix Backend and WebApp",
  "description": "Candidate Felix full stack isolated from the legacy deployment",
  "kind": "api",
  "renderer": {
    "type": "executable",
    "strict": true
  },
  "stack": {
    "family": "api",
    "role": "full-stack",
    "primaryService": "api",
    "name": "felix"
  },
  "release": {
    "stackId": "felix",
    "versionPolicy": "monotonic-floor",
    "versionFloor": "1.1.1",
    "componentVersionFloors": {
      "android": "1.1.4",
      "ios": "1.1.0",
      "web": "1.1.4",
      "legacy-webapp": "1.1.2",
      "api": "1.1.3"
    },
    "componentVersionTracks": {
      "flutter-app": [
        "api",
        "web",
        "android",
        "ios"
      ],
      "legacy-webapp": [
        "legacy-webapp"
      ]
    },
    "components": [
      "api",
      "web",
      "android",
      "ios",
      "legacy-webapp"
    ]
  },
  "exposure": {
    "type": "public",
    "publicDomainRequired": true,
    "traefik": true,
    "publishedPorts": true
  },
  "routing": {
    "containerPort": 8080,
    "apiBaseUrl": "https://api.felix-app.fe-wi.com",
    "domain": "api.felix-app.fe-wi.com",
    "healthPath": "/health",
    "publishedPort": 8083,
    "webContainerPort": 80,
    "webBaseUrl": "https://felix-app.fe-wi.com",
    "webDomain": "felix-app.fe-wi.com",
    "webHealthPath": "/health",
    "webPublishedPort": 8084,
    "pgadminPublishedPort": 5054,
    "traefikNetwork": "traefik-public",
    "traefikConstraintLabel": "traefik-public",
    "traefikCertResolver": "le",
    "sslMode": "proxy"
  },
  "database": {
    "type": "postgresql",
    "defaultMode": "local",
    "allowedModes": [
      "local",
      "external"
    ],
    "image": "postgres@sha256:79c06d285ed9186efbbc45c73413b3c3510c3c94ffede2f25d1e523f74d07f28",
    "imageTrackTag": "16-alpine",
    "pgadminImage": "dpage/pgadmin4@sha256:cefc4cc6b7d9d71a9e81e76fb9d7e14038ab5661b539a190eea1b63fa612589a",
    "pgadminImageTrackTag": "latest",
    "pgadminSecret": "FELIX_PGADMIN_PASSWORD"
  },
  "services": {
    "web": true,
    "api": true,
    "redis": true,
    "database": true,
    "redisImage": "redis@sha256:6ab0b6e7381779332f97b8ca76193e45b0756f38d4c0dcda72dbb3c32061ab99",
    "redisImageTrackTag": "7-alpine"
  },
  "image": {
    "name": "sokrates1989/python-api-felix",
    "defaultVersion": "1.0.8",
    "mutableTagsAllowed": false
  },
  "web": {
    "image": {
      "name": "sokrates1989/flutter-felix-web",
      "defaultVersion": "1.0.8",
      "mutableTagsAllowed": false
    },
    "resources": {
      "defaultReplicas": 1,
      "defaultMemoryLimit": "unlimited"
    }
  },
  "resources": {
    "defaultReplicas": 1,
    "defaultMemoryLimit": "unlimited",
    "defaultWebMemoryLimit": "unlimited"
  },
  "storage": {
    "dataRoot": "/swarm/prod/felix"
  },
  "secretsConfig": {
    "prefixed": false,
    "valueHelp": {
      "FELIX_DB_PASSWORD": "Strong, unique PostgreSQL password used by the Felix database and backend.",
      "FELIX_PGADMIN_PASSWORD": "Strong pgAdmin login password used only when database management is enabled.",
      "FELIX_AI_CHAT_API_KEY": "Provider API key for the optional AI chat capability.",
      "FELIX_WEB_PUSH_VAPID_PUBLIC_KEY": "URL-safe VAPID public key from the Web Push signing-key pair.",
      "FELIX_WEB_PUSH_VAPID_PRIVATE_KEY": "Confidential URL-safe VAPID private key matching the configured public key."
    }
  },
  "pgadmin": {
    "enabled": false,
    "domain": "pgadmin.felix-app.fe-wi.com",
    "email": "admin@fe-wi.com"
  },
  "cors": {
    "origins": [
      "https://felix-app.fe-wi.com"
    ]
  },
  "auth": {
    "provider": "keycloak",
    "serverUrl": "https://keycloak.fe-wi.com",
    "issuerUrl": "https://keycloak.fe-wi.com/realms/felix",
    "jwksUrl": "https://keycloak.fe-wi.com/realms/felix/protocol/openid-connect/certs",
    "realm": "felix",
    "realmDisplayName": "Felix",
    "realmSettings": {
      "enabled": true,
      "registrationAllowed": true,
      "resetPasswordAllowed": true,
      "rememberMe": true,
      "verifyEmail": true,
      "loginWithEmailAllowed": true
    },
    "themes": {
      "login": "default",
      "account": "default",
      "admin": "default",
      "email": "default"
    },
    "localization": {
      "enabled": true,
      "supportedLocales": [
        "de",
        "en"
      ],
      "defaultLocale": "de"
    },
    "emailSender": {
      "enabled": false,
      "from": "webmaster@felicitas-wisdom.com",
      "fromDisplayName": "FelixApp Keycloak Admin",
      "replyTo": "felix@felicitas-wisdom.com",
      "replyToDisplayName": "FelixApp",
      "envelopeFrom": "",
      "host": "smtp.strato.de",
      "port": 465,
      "startTls": false,
      "ssl": true,
      "authentication": true,
      "username": "webmaster@felicitas-wisdom.com"
    },
    "realmRoles": [
      {
        "name": "user",
        "description": "Standard Felix application user"
      },
      {
        "name": "admin",
        "description": "Felix application administrator"
      }
    ],
    "bootstrapTestUsersEnabled": true,
    "bootstrapTestUsers": [
      {
        "username": "user",
        "email": "felix-test-user@example.com",
        "firstName": "Test",
        "lastName": "User",
        "enabled": true,
        "emailVerified": true,
        "temporaryPassword": false,
        "realmRoles": [
          "user"
        ],
        "productionCleanupRequired": true
      },
      {
        "username": "admin",
        "email": "felix-test-admin@example.com",
        "firstName": "Admin",
        "lastName": "Administrator",
        "enabled": true,
        "emailVerified": true,
        "temporaryPassword": false,
        "realmRoles": [
          "user",
          "admin"
        ],
        "productionCleanupRequired": true
      }
    ],
    "frontendClientId": "felix-frontend",
    "audience": "felix-backend",
    "audienceMapperName": "backend-audience",
    "adminClientId": "felix-backend",
    "redirectUris": [
      "https://felix-app.fe-wi.com/auth/callback",
      "felixkc:/callback"
    ],
    "webOrigins": [
      "https://felix-app.fe-wi.com"
    ],
    "forbiddenDefaultUsernames": [
      "test"
    ],
    "serviceAccountClientRoles": {
      "realm-management": [
        "manage-users"
      ]
    },
    "protectedIdentity": {
      "realms": [
        "felixappnew"
      ],
      "clientIds": [
        "felixappnew-frontend"
      ],
      "origins": [
        "https://felix.app.fe-wi.com"
      ]
    }
  },
  "environment": {
    "APP_ENVIRONMENT": "production",
    "BACKEND_APP_ID": "felix",
    "APP_PROFILE": "felix",
    "PORT": "8080",
    "IMAGE_TAG": "1.0.8",
    "REDIS_URL": "redis://redis:6379/0",
    "DB_TYPE": "postgresql",
    "DB_MODE": "local",
    "DB_HOST": "postgres",
    "DB_PORT": "5432",
    "DB_NAME": "felix",
    "DB_USER": "felix",
    "CORS_ORIGINS": "https://felix-app.fe-wi.com",
    "AUTH_PROVIDER": "keycloak",
    "KEYCLOAK_SERVER_URL": "https://keycloak.fe-wi.com",
    "KEYCLOAK_REALM": "felix",
    "KEYCLOAK_CLIENT_ID": "felix-frontend",
    "KEYCLOAK_ISSUER_URL": "https://keycloak.fe-wi.com/realms/felix",
    "KEYCLOAK_JWKS_URL": "https://keycloak.fe-wi.com/realms/felix/protocol/openid-connect/certs",
    "KEYCLOAK_ENFORCE_AUDIENCE": "true",
    "KEYCLOAK_AUDIENCE": "felix-backend",
    "KEYCLOAK_ADMIN_CLIENT_ID": "felix-backend",
    "DEBUG": "false",
    "DEBUG_ENABLED": "false",
    "SQL_ECHO_ENABLED": "false",
    "ENABLE_HTTP_DEBUG_LOGGING": "false",
    "LOG_LEVEL": "INFO",
    "LOG_TIMEZONE": "Europe/Berlin",
    "LOG_REQUEST_HEADERS": "false",
    "LOG_REQUEST_BODY": "false",
    "LOG_RESPONSE_HEADERS": "false",
    "LOG_RESPONSE_BODY": "false",
    "AI_CHAT_DEBUG_ENABLED": "false",
    "AI_CHAT_DEBUG_INCLUDE_PROMPTS": "false"
  },
  "envKeys": [
    "APP_ENVIRONMENT",
    "BACKEND_APP_ID",
    "APP_PROFILE",
    "PORT",
    "IMAGE_TAG",
    "REDIS_URL",
    "DB_TYPE",
    "DB_MODE",
    "DB_HOST",
    "DB_PORT",
    "DB_NAME",
    "DB_USER",
    "CORS_ORIGINS",
    "AUTH_PROVIDER",
    "KEYCLOAK_SERVER_URL",
    "KEYCLOAK_REALM",
    "KEYCLOAK_CLIENT_ID",
    "KEYCLOAK_ISSUER_URL",
    "KEYCLOAK_JWKS_URL",
    "KEYCLOAK_ENFORCE_AUDIENCE",
    "KEYCLOAK_AUDIENCE",
    "KEYCLOAK_ADMIN_CLIENT_ID",
    "DEBUG",
    "DEBUG_ENABLED",
    "SQL_ECHO_ENABLED",
    "ENABLE_HTTP_DEBUG_LOGGING",
    "LOG_LEVEL",
    "LOG_TIMEZONE",
    "LOG_REQUEST_HEADERS",
    "LOG_REQUEST_BODY",
    "LOG_RESPONSE_HEADERS",
    "LOG_RESPONSE_BODY",
    "AI_CHAT_DEBUG_ENABLED",
    "AI_CHAT_DEBUG_INCLUDE_PROMPTS",
    "WEB_PUSH_VAPID_SUBJECT",
    "WEB_PUSH_DISPATCH_ENABLED",
    "DB_PASSWORD_FILE",
    "KEYCLOAK_ADMIN_CLIENT_SECRET_FILE",
    "WEB_PUSH_VAPID_PUBLIC_KEY_FILE",
    "WEB_PUSH_VAPID_PRIVATE_KEY_FILE"
  ],
  "secrets": [
    "FELIX_DB_PASSWORD",
    "FELIX_KEYCLOAK_ADMIN_CLIENT_SECRET"
  ],
  "optionalSecrets": [
    "FELIX_AI_CHAT_API_KEY",
    "FELIX_WEB_PUSH_VAPID_PUBLIC_KEY",
    "FELIX_WEB_PUSH_VAPID_PRIVATE_KEY"
  ],
  "secretMounts": [
    {
      "name": "FELIX_DB_PASSWORD",
      "envKey": "DB_PASSWORD_FILE",
      "target": "/run/secrets/FELIX_DB_PASSWORD"
    },
    {
      "name": "FELIX_KEYCLOAK_ADMIN_CLIENT_SECRET",
      "envKey": "KEYCLOAK_ADMIN_CLIENT_SECRET_FILE",
      "target": "/run/secrets/FELIX_KEYCLOAK_ADMIN_CLIENT_SECRET"
    }
  ],
  "capabilities": {
    "aiChat": {
      "enabled": false,
      "environment": {
        "AI_CHAT_COMPLETIONS_ENDPOINT": "https://api.openai.com/v1/chat/completions",
        "AI_CHAT_MODEL": "gpt-5-mini"
      },
      "secretMounts": [
        {
          "name": "FELIX_AI_CHAT_API_KEY",
          "envKey": "AI_CHAT_API_KEY_FILE",
          "target": "/run/secrets/FELIX_AI_CHAT_API_KEY"
        }
      ]
    },
    "webPush": {
      "enabled": true,
      "environment": {
        "WEB_PUSH_VAPID_SUBJECT": "mailto:operations@fe-wi.com",
        "WEB_PUSH_DISPATCH_ENABLED": "true"
      },
      "secretMounts": [
        {
          "name": "FELIX_WEB_PUSH_VAPID_PUBLIC_KEY",
          "envKey": "WEB_PUSH_VAPID_PUBLIC_KEY_FILE",
          "target": "/run/secrets/FELIX_WEB_PUSH_VAPID_PUBLIC_KEY"
        },
        {
          "name": "FELIX_WEB_PUSH_VAPID_PRIVATE_KEY",
          "envKey": "WEB_PUSH_VAPID_PRIVATE_KEY_FILE",
          "target": "/run/secrets/FELIX_WEB_PUSH_VAPID_PRIVATE_KEY"
        }
      ]
    }
  },
  "health": {
    "path": "/health",
    "expected": {
      "appId": "felix",
      "appProfile": "felix",
      "dataProfile": "postgresql",
      "authProvider": "keycloak",
      "startup": "ok"
    }
  }
}
